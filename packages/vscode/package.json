{
  "name": "@inspector-hook/vscode",
  "displayName": "Inspector Hook",
  "description": "AI Agent Monitoring & Orchestration for Claude Code and other AI agents",
  "version": "0.1.0",
  "publisher": "inspector-hook",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "ai",
    "agent",
    "monitoring",
    "hooks"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "inspectorHook.showPanel",
        "title": "Inspector Hook: Show Panel"
      },
      {
        "command": "inspectorHook.refreshLogs",
        "title": "Inspector Hook: Refresh Logs"
      },
      {
        "command": "inspectorHook.clearLogs",
        "title": "Inspector Hook: Clear Logs"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inspector-hook",
          "title": "Inspector Hook",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Inspector Hook",
      "properties": {
        "inspectorHook.httpPort": {
          "type": "number",
          "default": 52376,
          "description": "HTTP port for hook log ingestion"
        },
        "inspectorHook.wsPort": {
          "type": "number",
          "default": 52377,
          "description": "WebSocket port for real-time events"
        },
        "inspectorHook.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the core process"
        },
        "inspectorHook.logRetentionDays": {
          "type": "number",
          "default": 7,
          "description": "Number of days to retain logs"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --external:@inspector-hook/protocol --outfile=dist/extension.js",
    "dev": "pnpm build --watch",
    "package": "vsce package --no-dependencies",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inspector-hook/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0"
  }
}
