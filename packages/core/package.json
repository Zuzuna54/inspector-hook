{
	"name": "@inspector-hook/core",
	"version": "0.1.0",
	"description": "Core business logic for Inspector Hook",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"inspector-hook-core": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --outdir=dist --external:@inspector-hook/protocol && tsc --emitDeclarationOnly",
		"dev": "esbuild src/index.ts src/cli.ts --bundle --platform=node --outdir=dist --external:@inspector-hook/protocol --watch",
		"clean": "rm -rf dist *.tsbuildinfo",
		"typecheck": "tsc --noEmit",
		"test": "pnpm build && node --test test/*.test.js"
	},
	"dependencies": {
		"@inspector-hook/protocol": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^20.10.0"
	},
	"keywords": [
		"inspector-hook",
		"core",
		"ai-agent"
	],
	"license": "MIT"
}
