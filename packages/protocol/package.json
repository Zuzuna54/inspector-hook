{
  "name": "@inspector-hook/protocol",
  "version": "0.1.0",
  "description": "Shared protocol definitions for Inspector Hook",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.js"
  },
  "keywords": [
    "inspector-hook",
    "protocol",
    "types"
  ],
  "license": "MIT"
}
